# Database Connection String
# Get your connection string from Neon: https://console.neon.tech
# 
# Format: postgresql://user:password@host.neon.tech/database?sslmode=require
# 
# IMPORTANT: If password contains special characters, URL-encode them:
# @ = %40, : = %3A, / = %2F, ? = %3F, # = %23, [ = %5B, ] = %5D, % = %25, & = %26
#
DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"
